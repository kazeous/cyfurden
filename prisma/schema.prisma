generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BoothStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BoothRole {
  OWNER
  ADMIN
  STAFF
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProductStatus {
  DRAFT
  LIVE
  SOLD_OUT
  HIDDEN
}

enum VariantStatus {
  AVAILABLE
  LOW_STOCK
  PREORDER
  SOLD_OUT
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FULFILLED
}

enum OrderFulfillmentMethod {
  PICKUP
  SHIP
}

enum GachaBannerType {
  CHARACTER
  WEAPON
  COLLECTION
}

enum GachaRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum PromotionProductRole {
  BUY
  REWARD
}

enum FaceboothProjectKind {
  MERCH
  SCENE
}

enum PlatformRole {
  PLATFORM_VIEWER
  PLATFORM_OPERATOR
  PLATFORM_SUPER_ADMIN
}

enum PlatformGrantStatus {
  ACTIVE
  REVOKED
}

enum BoothServiceState {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum PlatformAuditTargetType {
  PLATFORM
  USER
  BOOTH
  MEMBERSHIP
  PLATFORM_ROLE_GRANT
  QUOTA
  STORAGE_ASSET
  STORAGE_RECONCILIATION
  DELETION_REQUEST
}

enum PlatformDeletionTargetType {
  USER
  BOOTH
}

enum PlatformDeletionState {
  PENDING
  CANCELLED
  FINALIZING
  COMPLETED
  BLOCKED
}

enum StorageAssetPurpose {
  BOOTH_LOGO
  PAYMENT_QR
  PRODUCT_IMAGE
  FACEBOOTH_ARTWORK
  FACEBOOTH_PREVIEW
}

enum StorageAssetState {
  RESERVED
  VERIFIED
  DETACHED
  DELETION_PENDING
  DELETED
  MISSING
  ORPHANED
}

enum StorageReconciliationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                       String                 @id
  name                     String
  email                    String                 @unique
  emailVerified            Boolean                @default(false)
  image                    String?
  role                     String?                @default("user")
  banned                   Boolean?               @default(false)
  banReason                String?
  banExpires               DateTime?
  twoFactorEnabled         Boolean?               @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  twoFactors               TwoFactor[]
  ownedBooths              Booth[]                @relation("BoothOwner")
  memberships              BoothMembership[]
  invitationsSent          TeamInvitation[]       @relation("InvitationSender")
  invitationsAccepted      TeamInvitation[]       @relation("InvitationAccepter")
  storefrontUpdates        StorefrontConfig[]     @relation("StorefrontUpdater")
  ordersConfirmed          Order[]                @relation("OrderConfirmer")
  faceboothProjectsCreated FaceboothProject[]     @relation("FaceboothProjectCreator")
  faceboothProjectsUpdated FaceboothProject[]     @relation("FaceboothProjectUpdater")
  faceboothPublications    FaceboothPublication[] @relation("FaceboothPublisher")
  auditLogs                AuditLog[]
  platformRoleGrant        PlatformRoleGrant?
  quotaOverride            UserQuotaOverride?

  @@map("user")
}

model Session {
  id                      String    @id
  expiresAt               DateTime
  token                   String    @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  ipAddress               String?
  userAgent               String?
  impersonatedBy          String?
  platformAuthenticatedAt DateTime?
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([secret])
  @@map("twoFactor")
}

model Booth {
  id                          String                     @id @default(cuid())
  slug                        String                     @unique
  name                        String
  logoObjectKey               String?
  socialLinks                 Json?
  status                      BoothStatus                @default(DRAFT)
  serviceState                BoothServiceState          @default(ACTIVE)
  serviceReason               String?
  serviceStateChangedByUserId String?
  serviceStateChangedAt       DateTime?
  serviceVersion              Int                        @default(1)
  locale                      String                     @default("en")
  currency                    String                     @default("VND")
  ownerId                     String
  owner                       User                       @relation("BoothOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  memberships                 BoothMembership[]
  invitations                 TeamInvitation[]
  storefront                  StorefrontConfig?
  paymentInstructions         BoothPaymentInstruction?
  categories                  Category[]
  products                    Product[]
  promotions                  QuantityPromotion[]
  events                      Event[]
  orders                      Order[]
  gacha                       GachaConfig?
  gachaBanners                GachaBanner[]
  faceboothProjects           FaceboothProject[]
  faceboothPublication        FaceboothPublication?
  auditLogs                   AuditLog[]
  quotaOverride               BoothQuotaOverride?
  storageAssets               StorageAsset[]
  storageReconciliations      StorageReconciliationRun[]

  @@index([ownerId])
  @@index([status])
  @@index([serviceState])
}

model BoothMembership {
  id        String           @id @default(cuid())
  boothId   String
  userId    String
  role      BoothRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  booth     Booth            @relation(fields: [boothId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boothId, userId])
  @@index([userId, status])
}

model TeamInvitation {
  id           String           @id @default(cuid())
  boothId      String
  email        String
  role         BoothRole
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  invitedById  String
  acceptedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  booth        Booth            @relation(fields: [boothId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?            @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([boothId, email, status])
  @@index([email, status])
}

model StorefrontConfig {
  id                String    @id @default(cuid())
  boothId           String    @unique
  schemaVersion     Int       @default(1)
  editVersion       Int       @default(1)
  draftDocument     Json
  publishedDocument Json?
  publishedAt       DateTime?
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booth             Booth     @relation(fields: [boothId], references: [id], onDelete: Cascade)
  updatedBy         User?     @relation("StorefrontUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model BoothPaymentInstruction {
  id                        String   @id @default(cuid())
  boothId                   String   @unique
  bankName                  String
  bankCode                  String?
  accountName               String
  accountNumber             String
  paymentLabel              String   @default("Bank transfer")
  qrObjectKey               String?
  transferReferenceTemplate String   @default("{code}")
  instructions              String   @db.Text
  disclaimer                String   @db.Text
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  booth                     Booth    @relation(fields: [boothId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(cuid())
  boothId     String
  slug        String
  name        String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booth       Booth     @relation(fields: [boothId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([boothId, slug])
  @@index([boothId, sortOrder])
}

model Product {
  id               String             @id @default(cuid())
  boothId          String
  categoryId       String?
  slug             String
  sku              String?
  name             String
  eyebrow          String?
  shortDescription String?
  description      String             @db.Text
  priceCents       BigInt
  status           ProductStatus      @default(DRAFT)
  featured         Boolean            @default(false)
  tags             String[]
  optionGroups     Json?
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  booth            Booth              @relation(fields: [boothId], references: [id], onDelete: Cascade)
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]
  orderItems       OrderItem[]
  promotionLinks   PromotionProduct[]

  @@unique([boothId, slug])
  @@unique([boothId, sku])
  @@index([boothId, status])
  @@index([boothId, sortOrder])
}

model ProductVariant {
  id              String           @id @default(cuid())
  productId       String
  sku             String
  label           String
  priceCents      BigInt?
  status          VariantStatus    @default(AVAILABLE)
  stockQuantity   Int?
  fulfillmentNote String?          @db.Text
  optionValues    Json?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  gachaPoolItems  GachaPoolEntry[]

  @@unique([productId, sku])
  @@index([productId, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  objectKey String
  alt       String
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, objectKey])
  @@index([productId, sortOrder])
}

model QuantityPromotion {
  id             String             @id @default(cuid())
  boothId        String
  name           String             @default("Quantity promotion")
  buyQuantity    Int                @default(3)
  rewardQuantity Int                @default(1)
  active         Boolean            @default(false)
  repeatable     Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  booth          Booth              @relation(fields: [boothId], references: [id], onDelete: Cascade)
  products       PromotionProduct[]

  @@index([boothId])
}

model PromotionProduct {
  promotionId String
  productId   String
  role        PromotionProductRole
  promotion   QuantityPromotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId, role])
}

model Event {
  id        String   @id @default(cuid())
  boothId   String
  name      String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booth     Booth    @relation(fields: [boothId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([id, boothId])
  @@index([boothId, startsAt, endsAt])
}

model Order {
  id                        String                  @id @default(cuid())
  boothId                   String
  eventId                   String?
  code                      String
  status                    OrderStatus             @default(PENDING)
  customerName              String
  customerEmail             String
  customerPhone             String?
  customerSocialContact     String?
  customerNote              String?                 @db.Text
  fulfillmentMethod         OrderFulfillmentMethod?
  shippingAddress           String?                 @db.Text
  shipmentCarrier           String?
  shipmentTrackingNumber    String?
  shipmentTrackingUrl       String?
  customerTransferReference String?
  subtotalCents             BigInt
  totalCents                BigInt
  currency                  String                  @default("VND")
  transferReference         String
  idempotencyKey            String
  paymentSnapshot           Json?
  placedAt                  DateTime                @default(now())
  expiresAt                 DateTime?
  confirmedAt               DateTime?
  confirmedById             String?
  fulfilledAt               DateTime?
  updatedAt                 DateTime                @updatedAt
  booth                     Booth                   @relation(fields: [boothId], references: [id], onDelete: Restrict)
  event                     Event?                  @relation(fields: [eventId, boothId], references: [id, boothId], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy               User?                   @relation("OrderConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  items                     OrderItem[]

  @@unique([boothId, code])
  @@unique([boothId, idempotencyKey])
  @@unique([boothId, transferReference])
  @@index([boothId, status, placedAt])
  @@index([boothId, eventId, placedAt])
}

model OrderItem {
  id                     String          @id @default(cuid())
  orderId                String
  productId              String?
  productVariantId       String?
  titleSnapshot          String
  variantSnapshot        String?
  unitPriceCents         BigInt
  originalUnitPriceCents BigInt?
  promotionNameSnapshot  String?
  quantity               Int
  inventoryDebited       Boolean         @default(false)
  order                  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant         ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model GachaConfig {
  id                String      @id @default(cuid())
  boothId           String      @unique
  enabled           Boolean     @default(false)
  title             String      @default("Wish upon the shelf")
  introduction      String      @default("Meet a surprise from this booth.") @db.Text
  gameTheme         String      @default("anemo")
  pityEnabled       Boolean     @default(true)
  guaranteedAt      Int         @default(50)
  guaranteedRarity  GachaRarity @default(EPIC)
  rates             Json
  publishedDocument Json?
  publishedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  booth             Booth       @relation(fields: [boothId], references: [id], onDelete: Cascade)
}

model GachaBanner {
  id            String           @id @default(cuid())
  boothId       String
  title         String
  copy          String           @db.Text
  type          GachaBannerType  @default(COLLECTION)
  theme         String           @default("anemo")
  featuredCount Int              @default(3)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean          @default(false)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  booth         Booth            @relation(fields: [boothId], references: [id], onDelete: Cascade)
  pool          GachaPoolEntry[]

  @@index([boothId, sortOrder])
}

model GachaPoolEntry {
  id               String          @id @default(cuid())
  bannerId         String
  productVariantId String?
  displayName      String
  rarity           GachaRarity     @default(COMMON)
  weight           Int             @default(1)
  featured         Boolean         @default(false)
  sortOrder        Int             @default(0)
  banner           GachaBanner     @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([bannerId, sortOrder])
}

model FaceboothProject {
  id               String               @id @default(cuid())
  boothId          String
  kind             FaceboothProjectKind
  schemaVersion    Int                  @default(1)
  editVersion      Int                  @default(1)
  name             String
  document         Json
  previewObjectKey String?
  createdById      String
  updatedById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  booth            Booth                @relation(fields: [boothId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation("FaceboothProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User                 @relation("FaceboothProjectUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([id, boothId])
  @@index([boothId, kind, updatedAt(sort: Desc)])
}

model FaceboothPublication {
  id               String   @id @default(cuid())
  boothId          String   @unique
  schemaVersion    Int      @default(1)
  revision         Int      @default(1)
  document         Json
  previewObjectKey String?
  publishedById    String
  publishedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
  booth            Booth    @relation(fields: [boothId], references: [id], onDelete: Cascade)
  publishedBy      User     @relation("FaceboothPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@index([boothId, revision])
}

model AuditLog {
  id          String   @id @default(cuid())
  boothId     String
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  booth       Booth    @relation(fields: [boothId], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([boothId, createdAt])
  @@index([actorUserId])
}

model PlatformRoleGrant {
  id              String              @id @default(cuid())
  userId          String              @unique
  role            PlatformRole
  status          PlatformGrantStatus @default(ACTIVE)
  grantedByUserId String
  grantReason     String
  grantedAt       DateTime            @default(now())
  revokedByUserId String?
  revokeReason    String?
  revokedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, status])
  @@index([grantedByUserId])
}

model PlatformAuditLog {
  id             String                  @id @default(cuid())
  actorUserId    String
  action         String
  targetType     PlatformAuditTargetType
  targetId       String?
  reason         String
  beforeMetadata Json?
  afterMetadata  Json?
  correlationId  String
  createdAt      DateTime                @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([correlationId])
}

model PlatformDeletionRequest {
  id                String                     @id @default(cuid())
  targetType        PlatformDeletionTargetType
  targetId          String
  state             PlatformDeletionState      @default(PENDING)
  requestedByUserId String
  reason            String
  requestedAt       DateTime                   @default(now())
  coolingOffEndsAt  DateTime
  blockers          Json?
  cancelledByUserId String?
  cancelledAt       DateTime?
  finalizedByUserId String?
  finalizedAt       DateTime?
  lastErrorCode     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([targetType, targetId, state])
  @@index([state, coolingOffEndsAt])
}

model PlatformQuotaDefault {
  id                   String   @id @default("global")
  maxOwnedBooths       Int      @default(5)
  maxTeamSeats         Int      @default(10)
  maxProducts          Int      @default(500)
  maxFaceboothProjects Int      @default(100)
  maxStorageBytes      BigInt   @default(5368709120)
  updatedByUserId      String?
  updateReason         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model UserQuotaOverride {
  id              String   @id @default(cuid())
  userId          String   @unique
  maxOwnedBooths  Int
  updatedByUserId String
  reason          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedByUserId])
}

model BoothQuotaOverride {
  id                   String   @id @default(cuid())
  boothId              String   @unique
  maxTeamSeats         Int?
  maxProducts          Int?
  maxFaceboothProjects Int?
  maxStorageBytes      BigInt?
  updatedByUserId      String
  reason               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  booth                Booth    @relation(fields: [boothId], references: [id], onDelete: Cascade)

  @@index([updatedByUserId])
}

model StorageAsset {
  id                    String              @id @default(cuid())
  boothId               String
  objectKey             String              @unique
  purpose               StorageAssetPurpose
  byteLength            BigInt
  verifiedMime          String?
  state                 StorageAssetState   @default(RESERVED)
  associatedRecordType  String?
  associatedRecordId    String?
  reservationExpiresAt  DateTime?
  verifiedAt            DateTime?
  detachedAt            DateTime?
  deletionRequestedAt   DateTime?
  deletedAt             DateTime?
  deletionAttempts      Int                 @default(0)
  lastDeletionErrorCode String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  booth                 Booth               @relation(fields: [boothId], references: [id], onDelete: Cascade)

  @@index([boothId, state])
  @@index([boothId, purpose, state])
  @@index([state, reservationExpiresAt])
  @@index([associatedRecordType, associatedRecordId])
}

model StorageReconciliationRun {
  id                      String                      @id @default(cuid())
  boothId                 String
  status                  StorageReconciliationStatus @default(PENDING)
  requestedByUserId       String
  providerCursor          String?
  trackedObjectCount      Int                         @default(0)
  trackedBytes            BigInt                      @default(0)
  reservedObjectCount     Int                         @default(0)
  reservedBytes           BigInt                      @default(0)
  untrackedObjectCount    Int                         @default(0)
  untrackedBytes          BigInt                      @default(0)
  missingObjectCount      Int                         @default(0)
  sizeMismatchObjectCount Int                         @default(0)
  safeErrorCode           String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  booth                   Booth                       @relation(fields: [boothId], references: [id], onDelete: Cascade)

  @@index([boothId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}
